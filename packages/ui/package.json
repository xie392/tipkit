      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tipkit/components": "workspace:*",
    "@tipkit/core": "workspace:*",
    "@tipkit/extensions": "workspace:*",
    "@tiptap/react": "^3.30.1",
    "lucide-react": "^0.469.0",
    "tippy.js": "^6.3.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "happy-dom": "^15.11.7"
  }
}
