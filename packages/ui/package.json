{
  "name": "@tipkit/ui",
  "version": "0.2.1",
  "author": "xie392",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xie392/tipkit.git"
  },
  "homepage": "https://github.com/xie392/tipkit",
  "bugs": {
    "url": "https://github.com/xie392/tipkit/issues"
  },
  "keywords": [
    "tiptap",
    "editor",
    "ui",
    "react",
    "slash-menu"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "TipKit 无头 UI 原语：浮层定位、键盘导航、激活态计算（仅布局，无颜色/字体）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tipkit/components": "workspace:*",
    "@tipkit/core": "workspace:*",
    "@tipkit/extensions": "workspace:*",
    "@tiptap/extension-color": "^3.30.1",
    "@tiptap/extension-font-family": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-cell": "^3.30.1",
    "@tiptap/extension-table-header": "^3.30.1",
    "@tiptap/extension-table-row": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "lucide-react": "^0.469.0",
    "tippy.js": "^6.3.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/pm": "^3.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
