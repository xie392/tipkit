{
  "name": "@tipkit/themes",
  "version": "0.0.0",
  "private": true,
  "description": "TipKit 内置主题皮肤：default 标准风格 + sketch 手绘风格，纯 CSS 变量 + 自定义 CSS",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
