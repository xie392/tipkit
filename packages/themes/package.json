    "./base.css": "./src/base.css",
    "./default.css": "./src/default.css",
    "./sketch.css": "./src/sketch.css"
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
