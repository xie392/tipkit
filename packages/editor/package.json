{
  "name": "@tipkit/editor",
  "version": "0.2.0",
  "author": "xie392",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xie392/tipkit.git"
  },
  "homepage": "https://github.com/xie392/tipkit",
  "bugs": {
    "url": "https://github.com/xie392/tipkit/issues"
  },
  "keywords": [
    "tiptap",
    "editor",
    "react",
    "headless",
    "rich-text"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "TipKit 聚合入口：core + extensions + ui 组装，对外暴露 <TipKitEditor> / useTipKitEditor",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tipkit/core": "workspace:*",
    "@tipkit/extensions": "workspace:*",
    "@tipkit/ui": "workspace:*",
    "@tiptap/extension-color": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-subscript": "^3.30.1",
    "@tiptap/extension-superscript": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tiptap/react": "^3.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tiptap/react": "^3.30.1",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
