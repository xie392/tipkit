{
  "name": "@tipkit/extensions",
  "version": "0.2.1",
  "author": "xie392",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xie392/tipkit.git"
  },
  "homepage": "https://github.com/xie392/tipkit",
  "bugs": {
    "url": "https://github.com/xie392/tipkit/issues"
  },
  "keywords": [
    "tiptap",
    "extension",
    "editor",
    "markdown",
    "rich-text"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "description": "TipKit 扩展集：全部 Tiptap 扩展（纯逻辑 + 语义类名，带少量可覆盖默认样式）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json --watch",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tipkit/components": "workspace:*",
    "@tipkit/core": "workspace:*",
    "@tiptap/extension-bold": "^3.30.1",
    "@tiptap/extension-character-count": "^3.30.2",
    "@tiptap/extension-code": "^3.30.1",
    "@tiptap/extension-code-block-lowlight": "^3.30.3",
    "@tiptap/extension-color": "^3.30.1",
    "@tiptap/extension-dropcursor": "^3.30.2",
    "@tiptap/extension-focus": "^3.30.3",
    "@tiptap/extension-font-family": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-horizontal-rule": "^3.30.2",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-italic": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-strike": "^3.30.1",
    "@tiptap/extension-subscript": "^3.30.1",
    "@tiptap/extension-superscript": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-cell": "^3.30.1",
    "@tiptap/extension-table-header": "^3.30.1",
    "@tiptap/extension-table-row": "^3.30.1",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/extension-typography": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/suggestion": "^3.30.2",
    "katex": "^0.16.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.469.0",
    "roughjs": "^4.6.6"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/pm": "^3.30.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "happy-dom": "^15.11.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
