{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@tipkit/core": ["packages/core/src/index.ts"],
      "@tipkit/extensions": ["packages/extensions/src/index.ts"],
      "@tipkit/ui": ["packages/ui/src/index.ts"],
      "@tipkit/components": ["packages/components/src/index.ts"],
      "@tipkit/themes": ["packages/themes/src/index.ts"],
      "@tipkit/editor": ["packages/editor/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
