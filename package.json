{
  "name": "tipkit",
  "version": "0.0.0",
  "private": true,
  "description": "TipKit —— 基于 Tiptap v3 + shadcn/ui 的无头富文本编辑器套件，风格由消费方项目决定",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "@tiptap/react@3.30.5": "patches/@tiptap__react@3.30.5.patch"
    }
  }
}
